# LLM provider: openai, huggingface, ollama
LLM_PROVIDER=ollama
MODEL_NAME=llama3

# If using Ollama, API keys are not needed
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=

# Replace localhost if Ollama is hosted on another machine
OLLAMA_URL=http://localhost:11434

# Wazuh alerts file
WAZUH_ALERTS_PATH=/var/ossec/logs/alerts/alerts.json
